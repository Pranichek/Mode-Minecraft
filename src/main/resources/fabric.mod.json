		"sources": "https://github.com/Pranichek/Mode-Minecraft"
	},
	"license": "ARR",
	"icon": "assets/crimsonmoon/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.crimsonmoon.CrimsonMoon"
		],
		"client": [ "com.crimsonmoon.CrimsonMoonClient" ]
	},
	"mixins": [
		"crimsonmoon.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"geckolib": "*",
		"trinkets": "*"
	}
}